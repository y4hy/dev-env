# This is a complete, modern configuration for the Dunst notification daemon.
# Designed for a dark desktop theme with a Nerd Font.
#
# File location: ~/.config/dunst/dunstrc

[global]
    ### Display ###
    # Which monitor to display notifications on. 0 is primary.
    monitor = 0
    # Follow mouse pointer to the active monitor.
    follow = mouse
    
    # Modern geometry settings (replaces deprecated 'geometry')
    width = 300
    height = (0, 300)
    origin = top-right
    offset = 30x50
    
    # Maximum number of notifications to show
    notification_limit = 5

    ### Styling ###
    # A simple but effective format.
    # %a = application name
    # %s = summary (the title)
    # %b = body (the message)
    # %I = icon path
    # %p = progress value
    format = "<b>%s</b>\n%b"

    # The font for the notification text.
    # Use the Nerd Font you installed to get icons.
    font = JetBrainsMono Nerd Font 10

    # Whether to allow markup (for bold, italics, etc.)
    markup = full

    # Alignment of text. `left`, `center`, or `right`.
    alignment = left
    # Vertical alignment of text. `top`, `center`, `bottom`.
    vertical_alignment = center

    # Path to default icons.
    icon_path = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/apps/:/usr/share/icons/Adwaita/16x16/legacy/
    
    # Icon size
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    ### Behavior ###
    # Don't show notifications older than 60 seconds.
    show_age_threshold = 60
    # Word wrapping.
    word_wrap = yes
    # Show how many notifications are hidden.
    indicate_hidden = yes
    # Stack notifications on top of each other.
    stack_duplicates = true
    # Hide duplicate notifications.
    hide_duplicate_count = false
    
    # Frame settings
    frame_width = 2
    frame_color = "#3584e4"
    
    # Corner radius for rounded notifications
    corner_radius = 8
    
    # Progress bar settings
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

# --- THEME AND COLORS (Adwaita Dark Palette) ---
# This palette uses the official colors from GNOME's Adwaita Dark theme.

[urgency_low]
    # For low-urgency notifications.
    background = "#242424"
    foreground = "#eeeeec"
    timeout = 5

[urgency_normal]
    # For standard notifications.
    background = "#242424"
    foreground = "#eeeeec"
    timeout = 8

[urgency_critical]
    # For critical notifications.
    background = "#c01c28"
    foreground = "#ffffff"
    frame_color = "#c01c28"
    timeout = 0
